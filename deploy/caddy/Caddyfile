(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

amusemonk.com {
	import common
	reverse_proxy prod-web:3400
}

sandbox.amusemonk.com {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy sandbox-web:3400
}

www.amusemonk.com {
	redir https://amusemonk.com{uri} permanent
}
