(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Scanners probe every host for secrets and admin pages: answer them here, so they never reach an app or log as its errors.
(probes) {
	@probe path /.env* /.git* /.svn* /.hg* /.aws* /.ssh* /.DS_Store /*.php /actuator* /_profiler* /wp-* /phpmyadmin* /server-status*
	handle @probe {
		respond 404
	}
}

# routes/<env>.caddy is written by box-deploy.sh: forward once the environment has been deployed, otherwise answer
# "Not live yet" here rather than fail to reach a container that doesn't exist.
sandbox.amusemonk.com {
	import common
	header X-Robots-Tag "noindex, nofollow"
	import probes
	handle {
		import routes/sandbox.caddy
	}
}

fintech.amusemonk.com {
	import common
	import probes
	handle {
		import routes/fintech.caddy
	}
}

galaxy.amusemonk.com {
	import common
	import probes
	handle {
		import routes/galaxy.caddy
	}
}

# The landing page: a static site with a client-side demo; it never talks to an environment.
amusemonk.com {
	import common
	header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
	root * /etc/caddy/site
	file_server
}

www.amusemonk.com {
	redir https://amusemonk.com{uri} permanent
}
