(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# The landing page: a static site with a client-side demo; it never talks to an environment.
amusemonk.com {
	import common
	header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
	root * /etc/caddy/site
	file_server
}

sandbox.amusemonk.com {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy sandbox-web:3400
}

www.amusemonk.com {
	redir https://amusemonk.com{uri} permanent
}
