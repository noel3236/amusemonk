# Sandbox gateway host — gatekeeper (auth) and UAPI (payouts) both live here
GATEWAY_BASE_URL=https://sandbox.celestiapayment.com

# All outbound calls go through the VPN (docker compose up vpn)
EGRESS_PROXY_URL=http://127.0.0.1:8888

# MySQL (RDS in production: DB_SSL=rds)
DATABASE_URL=mysql://amusemonk:amusemonk-dev@127.0.0.1:3306/amusemonk
DB_SSL=off
# Database for `pnpm checks` (never the dev or production one)
TEST_DATABASE_URL=mysql://amusemonk:amusemonk-dev@127.0.0.1:3306/amusemonk_test

# next-auth — openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3400

# Encrypts users' UAPI secrets at rest — openssl rand -base64 32. Losing or changing it makes stored keys unreadable.
SECRETS_KEY=

# Raw uploads: `s3` in production (S3_BUCKET, AWS_REGION; credentials from the instance role), `local` for dev
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
# S3_BUCKET=
# AWS_REGION=eu-west-2

# Worker (pnpm worker). Defaults shown.
# WORKER_ID=worker-1
# DISPATCH_INTERVAL_SECONDS=5
# DISPATCH_BATCH_SIZE=10
# POLL_INTERVAL_SECONDS=30
# RECONCILE_INTERVAL_SECONDS=60
# STUCK_AFTER_SECONDS=120
# BALANCE_BACKOFF_SECONDS=300
# REFUND_WATCH_DAYS=3
# PENNY_DROP_REQUIRED=true
