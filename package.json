{
  "name": "amusemonk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && eslint && vitest run",
    "migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "kysely": "^0.29.7",
    "lucide-react": "^1.23.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@8.15.4",
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4"
  }
}
